{
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "battles.hybridfunding.co"
        }
      ],
      "destination": "/tradehouse",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/dna-test",
      "destination": "/dna-test/index.html"
    },
    {
      "source": "/dna-test/",
      "destination": "/dna-test/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/battles/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "ALLOWALL"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors *"
        }
      ]
    }
  ]
}
