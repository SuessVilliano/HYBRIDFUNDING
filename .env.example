# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/hybridfunding

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
VITE_STRIPE_PUBLIC_KEY=pk_live_...

# ── Stream Video (Trader Battles) ─────────────────────────────────────────────
# Get your keys at https://getstream.io → Create App → Video & Audio
# The public key is exposed to the browser; the secret stays server-side only.
VITE_STREAM_KEY=your_stream_api_key_here
STREAM_KEY=your_stream_api_key_here
STREAM_SECRET=your_stream_api_secret_here

# ── Session ───────────────────────────────────────────────────────────────────
SESSION_SECRET=change_me_to_a_long_random_string


# Trade House public competition feed
# Demo/simulated competition accounts only. Each entry may use accountId OR the
# public Hybrid Funding dashboard URL. Official standings read these dashboards.
TRADEHOUSE_SEASON_NAME=Season 1
TRADEHOUSE_SEASON_STATUS=forming
TRADEHOUSE_SEASON_ENDS_AT=
TRADEHOUSE_ROSTER_JSON=[{"id":"trader-01","name":"NQKing","startingBalance":25000,"division":"trading","platform":"matchtrader","dashboardUrl":"https://hybridfundingdashboard.propaccount.com/en/public-overview/REPLACE_ME"}]

# Publish only confirmed/redacted payout records. Leave [] until proof exists.
HYBRID_PUBLIC_PAYOUTS_JSON=[]
